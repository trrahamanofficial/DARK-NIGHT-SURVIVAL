; DARK NIGHT: SURVIVAL — Godot 4 project
config_version=5

[application]
config/name="DARK NIGHT: SURVIVAL"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.008, 0.012, 0.018, 1)

[autoload]
SaveManager="*res://scripts/save_manager.gd"
StoryCampaign="*res://scripts/story_campaign.gd"
MapManager="*res://scripts/map_manager.gd"

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
run={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
flashlight={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":70)]}
